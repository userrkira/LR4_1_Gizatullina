<Window x:Class="LR4_1_Gizatullina.View.WindowRole"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Должности" Height="350" Width="450">

    <Grid Margin="10">
        <ListView x:Name="lvRole">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Код"
                                    DisplayMemberBinding="{Binding Id}"
                                    Width="80"/>
                    <GridViewColumn Header="Название должности"
                                    DisplayMemberBinding="{Binding NameRole}"
                                    Width="250"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>

</Window>